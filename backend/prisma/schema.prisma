// ============================================================================
// Qisma (قِسمة) — Shared Property Ledger
// Prisma schema — core data model for the MVP (see /docs/ROADMAP.md)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER // مالك/شريك
  MANAGER // مدير العقار (يدير الأموال والعمليات)
  ACCOUNTANT // محاسب (صلاحية مراجعة، بدون تعديل ملكية)
  VIEWER // مشاهدة فقط
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum VerificationStatus {
  REPORTED // مُدخل فقط
  EVIDENCE_SUBMITTED // أُرفق إثبات
  UNDER_REVIEW // قيد المراجعة
  VERIFIED // موثّق
  DISPUTED // محل اعتراض
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum EvidenceRequestStatus {
  PENDING
  UPLOADED
  REVIEWED
  COMPLETED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  AMOUNT_DIFFERENT
}

enum ClosingStatus {
  OPEN
  CLOSED
}

enum DistributionStatus {
  PENDING
  APPROVED
  PAID
}

enum DecisionStatus {
  VOTING
  APPROVED
  REJECTED
  EXECUTED
}

enum VoteChoice {
  APPROVE
  REJECT
}

// Approval / voting rule attached to a property, or overridden per-decision
enum ApprovalRuleType {
  NONE // لا يحتاج موافقة (أقل من حد معيّن)
  MANAGER_APPROVAL // موافقة المدير فقط
  MAJORITY_VOTE // أغلبية بسيطة من نسب الملكية
  TWO_THIRDS_VOTE // ثلثا الملكية
  UNANIMOUS_VOTE // إجماع الشركاء
}

enum DocumentCategory {
  OWNERSHIP
  CONTRACT
  INVOICE
  RECEIPT
  BANK_STATEMENT
  DECISION
  OTHER
}

// Chosen once at registration. OWNER gets the shared-property ledger
// (everything above); BROKER gets the separate listings/leads workspace
// below — same account, same login, different home screen.
enum AccountType {
  OWNER
  BROKER
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  WITHDRAWN
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATING
  WON
  LOST
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String      @id @default(cuid())
  fullName     String
  email        String      @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  accountType  AccountType @default(OWNER)
  createdAt    DateTime    @default(now())

  orgMemberships      OrganizationMember[]
  propertyMemberships PropertyMember[]
  ownershipRecords    OwnershipRecord[]
  transactionsCreated Transaction[]        @relation("TransactionCreatedBy")
  evidenceUploaded    Evidence[]           @relation("EvidenceUploadedBy")
  disputesRaised      Dispute[]            @relation("DisputeRaisedBy")
  disputeComments     DisputeComment[]
  evidenceRequestsMade      EvidenceRequest[] @relation("EvidenceRequestedBy")
  evidenceRequestsAssigned  EvidenceRequest[] @relation("EvidenceAssignedTo")
  decisionsCreated    Decision[]           @relation("DecisionCreatedBy")
  votes               DecisionVote[]
  distributionItems   DistributionItem[]
  documentsUploaded   Document[]
  notifications       Notification[]
  auditLogsActed      AuditLog[]

  // Broker workspace (only populated when accountType = BROKER)
  listingsAsBroker Listing[] @relation("BrokerListings")
  leadsAsBroker    Lead[]    @relation("BrokerLeads")

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members    OrganizationMember[]
  properties Property[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(VIEWER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Property & ownership
// ---------------------------------------------------------------------------

model Property {
  id                      String           @id @default(cuid())
  organizationId          String
  name                    String
  address                 String?
  estimatedValue          Float?
  approvalRuleType        ApprovalRuleType @default(MAJORITY_VOTE)
  // decisions below this JD amount need no vote (manager can act alone)
  noApprovalBelowAmount   Float            @default(500)
  // decisions below this JD amount only need manager+one-owner approval
  managerApprovalBelowAmount Float         @default(2000)
  createdAt               DateTime         @default(now())

  organization     Organization       @relation(fields: [organizationId], references: [id])
  members          PropertyMember[]
  ownershipRecords OwnershipRecord[]
  transactions     Transaction[]
  disputes         Dispute[]
  evidenceRequests EvidenceRequest[]
  monthlyClosings  MonthlyClosing[]
  distributions    Distribution[]
  decisions        Decision[]
  documents        Document[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  auditLogs        AuditLog[]

  @@map("properties")
}

model PropertyMember {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  role       Role     @default(VIEWER)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([propertyId, userId])
  @@map("property_members")
}

model OwnershipRecord {
  id            String    @id @default(cuid())
  propertyId    String
  userId        String
  sharePercent  Float
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = current
  documentId    String?
  note          String?
  createdAt     DateTime  @default(now())

  property Property  @relation(fields: [propertyId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  @@map("ownership_records")
}

// ---------------------------------------------------------------------------
// Financial ledger
// ---------------------------------------------------------------------------

model Transaction {
  id               String             @id @default(cuid())
  propertyId       String
  type             TransactionType
  category         String // rent, maintenance, electricity, cleaning, management, other...
  amount           Float
  description      String?
  date             DateTime
  status           VerificationStatus @default(REPORTED)
  createdById      String
  monthlyClosingId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  property       Property        @relation(fields: [propertyId], references: [id])
  createdBy      User            @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  monthlyClosing MonthlyClosing? @relation(fields: [monthlyClosingId], references: [id])
  evidence       Evidence[]
  disputes       Dispute[]
  confirmation   Confirmation?
  evidenceRequests EvidenceRequest[]

  @@map("transactions")
}

model Evidence {
  id            String   @id @default(cuid())
  transactionId String
  documentId    String
  uploadedById  String
  note          String?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  document    Document    @relation(fields: [documentId], references: [id])
  uploadedBy  User        @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])

  @@map("evidence")
}

model EvidenceRequest {
  id            String                @id @default(cuid())
  propertyId    String
  transactionId String?
  requestedById String
  assignedToId  String?
  message       String
  status        EvidenceRequestStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  requestedBy User         @relation("EvidenceRequestedBy", fields: [requestedById], references: [id])
  assignedTo  User?        @relation("EvidenceAssignedTo", fields: [assignedToId], references: [id])

  @@map("evidence_requests")
}

// Third-party confirmation (e.g. tenant confirming a reported rent payment)
model Confirmation {
  id                String             @id @default(cuid())
  transactionId     String             @unique
  confirmedAmount   Float?
  status            ConfirmationStatus @default(PENDING)
  respondentName    String?
  respondentContact String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("confirmations")
}

model Dispute {
  id             String        @id @default(cuid())
  propertyId     String
  transactionId  String
  raisedById     String
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  property    Property         @relation(fields: [propertyId], references: [id])
  transaction Transaction      @relation(fields: [transactionId], references: [id])
  raisedBy    User             @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  comments    DisputeComment[]

  @@map("disputes")
}

model DisputeComment {
  id        String   @id @default(cuid())
  disputeId String
  authorId  String
  message   String
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@map("dispute_comments")
}

// ---------------------------------------------------------------------------
// Monthly closing & distribution
// ---------------------------------------------------------------------------

model MonthlyClosing {
  id                 String        @id @default(cuid())
  propertyId         String
  periodYear         Int
  periodMonth        Int // 1-12
  status             ClosingStatus @default(OPEN)
  reportedIncome     Float         @default(0)
  verifiedIncome     Float         @default(0)
  unverifiedIncome   Float         @default(0)
  reportedExpenses   Float         @default(0)
  verifiedExpenses   Float         @default(0)
  unverifiedExpenses Float         @default(0)
  netVerifiedIncome  Float         @default(0)
  openDisputes       Int           @default(0)
  closedAt           DateTime?
  closedById         String?
  createdAt          DateTime      @default(now())

  property     Property      @relation(fields: [propertyId], references: [id])
  transactions Transaction[]
  distribution Distribution?

  @@unique([propertyId, periodYear, periodMonth])
  @@map("monthly_closings")
}

model Distribution {
  id               String              @id @default(cuid())
  propertyId       String
  monthlyClosingId String              @unique
  netIncome        Float
  status           DistributionStatus  @default(PENDING)
  createdAt        DateTime            @default(now())

  property       Property           @relation(fields: [propertyId], references: [id])
  monthlyClosing MonthlyClosing     @relation(fields: [monthlyClosingId], references: [id])
  items          DistributionItem[]

  @@map("distributions")
}

model DistributionItem {
  id             String    @id @default(cuid())
  distributionId String
  userId         String
  sharePercent   Float
  amount         Float
  paid           Boolean   @default(false)
  paidAt         DateTime?

  distribution Distribution @relation(fields: [distributionId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("distribution_items")
}

// ---------------------------------------------------------------------------
// Decisions & governance
// ---------------------------------------------------------------------------

model Decision {
  id            String           @id @default(cuid())
  propertyId    String
  title         String
  description   String?
  amount        Float?
  ruleType      ApprovalRuleType
  status        DecisionStatus   @default(VOTING)
  createdById   String
  resultPercent Float?
  executedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  property  Property       @relation(fields: [propertyId], references: [id])
  createdBy User           @relation("DecisionCreatedBy", fields: [createdById], references: [id])
  votes     DecisionVote[]

  @@map("decisions")
}

model DecisionVote {
  id         String     @id @default(cuid())
  decisionId String
  userId     String
  choice     VoteChoice
  createdAt  DateTime   @default(now())

  decision Decision @relation(fields: [decisionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([decisionId, userId])
  @@map("decision_votes")
}

// ---------------------------------------------------------------------------
// Documents, notifications, activity & audit
// ---------------------------------------------------------------------------

model Document {
  id           String           @id @default(cuid())
  propertyId   String
  category     DocumentCategory @default(OTHER)
  fileName     String
  fileUrl      String
  uploadedById String
  createdAt    DateTime         @default(now())

  property         Property          @relation(fields: [propertyId], references: [id])
  uploadedBy       User              @relation(fields: [uploadedById], references: [id])
  evidenceLinks    Evidence[]
  ownershipRecords OwnershipRecord[]

  @@map("documents")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  propertyId String?
  type       String
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  propertyId String
  actorId    String?
  action     String
  details    String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@map("activity_logs")
}

// Sensitive-change audit trail (immutable from the UI)
model AuditLog {
  id          String   @id @default(cuid())
  propertyId  String
  actorId     String
  entityType  String
  entityId    String
  action      String
  beforeValue String?
  afterValue  String?
  reason      String?
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  actor    User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Broker workspace — a separate, lightweight CRM for real-estate brokers/
// agents (accountType = BROKER): the listings they're marketing and the
// potential buyers they're working with, linked together. Independent of
// the shared-ownership ledger above, but same look, same login, same app.
// ---------------------------------------------------------------------------

model Listing {
  id           String        @id @default(cuid())
  brokerId     String
  title        String
  propertyType String // شقة، فيلا، أرض، محل تجاري...
  listingType  ListingType
  price        Float
  city         String?
  address      String?
  bedrooms     Int?
  bathrooms    Int?
  areaSqm      Float?
  description  String?
  status       ListingStatus @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  broker User   @relation("BrokerListings", fields: [brokerId], references: [id])
  leads  Lead[]

  @@map("listings")
}

model Lead {
  id        String     @id @default(cuid())
  brokerId  String
  listingId String?
  fullName  String
  phone     String?
  email     String?
  budgetMin Float?
  budgetMax Float?
  notes     String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  broker  User     @relation("BrokerLeads", fields: [brokerId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@map("leads")
}

